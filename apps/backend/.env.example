PORT=3001
# Comma-separated. In development, localhost, 127.0.0.1, and private LAN hosts are also allowed.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Neon Postgres — prefer pooled for the Nest app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler:5432/DB_NAME?sslmode=require

# true creates/updates tables automatically (dev only)
TYPEORM_SYNCHRONIZE=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Neon Object Storage (S3-compatible) — from Console / neon deploy
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
NEON_S3_BUCKET=assets

# Per-file upload cap and per-account ciphertext quota (50 MB default)
MAX_UPLOAD_BYTES=52428800
STORAGE_QUOTA_BYTES=52428800
