{
  "name": "secure-cloud-storage-system",
  "version": "1.0.0",
  "private": true,
  "description": "Secure cloud storage system monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run start:dev -w @secure-cloud/backend",
    "dev:frontend": "npm run dev -w @secure-cloud/frontend",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w @secure-cloud/backend",
    "build:frontend": "npm run build -w @secure-cloud/frontend",
    "start:backend": "npm run start:prod -w @secure-cloud/backend",
    "start:frontend": "npm run start -w @secure-cloud/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
